# ==============================================================================
# AdesHub Root .gitignore
# ==============================================================================

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Explicitly preserve template / example files
!.env.example
!*.env.example
!frontend/.env.example

# Database Files & Dumps
*.sqlite3
*.sqlite3-journal
*.db
*.sqlite
*.sql
*.dump
backend/db.sqlite3

# Node & Frontend Build Artifacts
node_modules/
*/node_modules/
frontend/node_modules/
dist/
*/dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Build
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
ENV/
env/
.venv/
*/venv/
*/.venv/

# Django Static & Runtime Logs
*.log
logs/
local_settings.py
staticfiles/
backend/staticfiles/

# Django Media (preserve committed catalog product and category images)
media/*
!media/categories/
!media/products/
backend/media/*
!backend/media/categories/
!backend/media/products/

# Sensitive Certificates & Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
id_rsa*
secrets.json
credentials.json

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
