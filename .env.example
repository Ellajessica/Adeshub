# AdesHub Backend Environment Configuration Template
# DO NOT place actual production passwords or secrets in this template file!

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-adeshub-development-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# Option A: Standard 12-factor cloud connection string (takes precedence if provided)
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/adeshub_db
# Option B: Discrete connection variables
DATABASE_NAME=adeshub_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Comma-separated trusted origins for HTTPS requests (e.g., https://adeshubafricanstore.com)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# API Rate Limiting / Throttling (requests per minute)
THROTTLE_ANON_RATE=200/minute
THROTTLE_USER_RATE=1000/minute

# Frontend URL for Stripe Redirects (AdesHub Vite frontend runs on port 3000)
FRONTEND_URL=http://localhost:3000

# Stripe Payment Gateway Configuration
# Test credentials format: sk_test_... / pk_test_... / whsec_...
# Live credentials format: sk_live_... / pk_live_... / whsec_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
STRIPE_CURRENCY=gbp

# ==============================================================================
# Transactional Email Configuration (Resend & Fallbacks)
# ==============================================================================
# 1. Resend API Key (Create key with Sending Access at https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Sender Address (Must belong to a domain verified in Resend)
#    - Production (after DNS verification for send subdomain): AdesHub <orders@send.adeshubafricanstore.com>
#    - Development / Sandbox (before custom domain is verified): AdesHub <onboarding@resend.dev>
EMAIL_FROM=AdesHub <orders@send.adeshubafricanstore.com>

# 3. Customer Reply-To and Support Address (Client's business email hosted on Zoho Mail)
EMAIL_REPLY_TO=Info@adeshub.co.uk
SUPPORT_EMAIL=Info@adeshub.co.uk
SUPPORT_PHONE=+44 (0) 20 1234 5678

# 4. Optional Local Development Fallback (used only if RESEND_API_KEY is empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Password Reset Security (seconds: 86400 = 24 hours)
PASSWORD_RESET_TIMEOUT=86400

